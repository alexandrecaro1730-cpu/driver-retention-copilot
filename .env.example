# -----------------------------------------------------------------------------
# Strategist mode
# -----------------------------------------------------------------------------
# heuristic: offline, deterministic, no external credentials required.
# openai: real LLM proposal + LLM revision, both still checked by deterministic compliance.
STRATEGIST_PROVIDER=heuristic

# Required only when STRATEGIST_PROVIDER=openai.
# Set this to a structured-output model available to your account.
OPENAI_MODEL=
# Keep the model configurable because account access and model availability vary.
OPENAI_API_KEY=


# Bounded external-call controls.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=3000

# Local paths can be overridden in deployed environments.
DATA_DIR=./data
STATE_DB_PATH=./var/copilot_state.sqlite3
LOG_LEVEL=INFO
MAX_REVISIONS=2
